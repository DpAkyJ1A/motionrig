# Analytics for the landing. Both optional: with neither set there is no consent banner and
# nothing loads. NEXT_PUBLIC_ values are inlined at build time, so a change needs a rebuild.

# Google Analytics 4 measurement ID: Admin → Data collection and modification → Data streams → your web stream
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project ID: Settings → Overview (the ID in the tracking code)
NEXT_PUBLIC_CLARITY_ID=
